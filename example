import streamlit as st
import pandas as pd
import numpy as np

st.set_page_config(page_title="Test Chart App", layout="wide")
st.title("✅ Chart Render Test")

st.header("Working Chart with st.line_chart")

# ✅ Clean, working chart
x = np.linspace(0, 99, 100)
y = np.random.normal(loc=100, scale=10, size=100).cumsum()

df = pd.DataFrame({
    "Day": x,
    "Value": y
})

st.line_chart(df.set_index("Day"))
